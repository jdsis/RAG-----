# ============================================================
# 服务器环境配置模板
# 用法：复制为 .env 后，替换下面所有 CHANGE_ME 占位符
# ============================================================

# ---- 数据库：本机 MySQL ----
# 密码见部署脚本 setup-server.sh 创建 MySQL 用户时输出的值
DATABASE_URL=mysql+pymysql://rag:CHANGE_ME_DB_PASSWORD@127.0.0.1:3306/rag_kb?charset=utf8mb4

# ---- 模型服务：指向暴露 Ollama 的公网地址 ----
OLLAMA_BASE_URL=https://CHANGE_ME_YOUR_OLLAMA_HOST
CHAT_MODEL=qwen3:8b
EMBEDDING_MODEL=qwen3-embedding:0.6b
# 8B 模型经公网隧道，给足超时（秒）
OLLAMA_TIMEOUT_SECONDS=60
# 若走公网 https 域名，保持 false；若指向内网地址需改为 true
ALLOW_PRIVATE_MODEL_URLS=false

# ---- 存储路径：挂到持久目录，别放代码目录里 ----
CHROMA_DIR=/opt/rag-kb/data/chroma
UPLOAD_DIR=/opt/rag-kb/data/uploads

# ---- 安全：必须换成随机密钥，切勿沿用示例值 ----
# 生成方式：python3 -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=CHANGE_ME_TO_RANDOM_64_CHARS

# ---- 允许访问的前端地址（换成实际部署地址） ----
CORS_ORIGINS=http://CHANGE_ME_YOUR_HOST

# ---- 上传限制 ----
MAX_UPLOAD_BYTES=52428800
MAX_AVATAR_BYTES=2097152
MAX_WEB_PAGE_BYTES=2097152

# ---- 邮件服务（用于验证码/邀请码，不需要可留空） ----
SMTP_HOST=smtp.163.com
SMTP_PORT=465
SMTP_USERNAME=CHANGE_ME_YOUR_EMAIL
SMTP_PASSWORD=CHANGE_ME_SMTP_AUTH_CODE
SMTP_FROM_EMAIL=CHANGE_ME_YOUR_EMAIL
SMTP_FROM_NAME=技术知识库问答系统
SMTP_USE_SSL=true
SMTP_USE_TLS=false

# ---- 检索参数 ----
CHUNK_SIZE=600
CHUNK_OVERLAP=100
TOP_K=5
