# ============================================================
# 服务器专用环境配置（Alibaba Cloud Linux 3 / 方案 A）
# 位置：/opt/rag-kb/.env
# 说明：下面所有 <...> 占位符都要替换成你自己的真实值
# ============================================================

# ---- 数据库：本机 MySQL ----
# 用户名 rag / 密码见部署脚本中创建 MySQL 用户时设置的密码
DATABASE_URL=mysql+pymysql://rag:CHANGE_ME_DB_PASSWORD@127.0.0.1:3306/rag_kb?charset=utf8mb4

# ---- 模型服务：指向本机通过 Cloudflare 隧道暴露的 Ollama ----
# 已配置为命名隧道固定地址（不会变）
OLLAMA_BASE_URL=https://ollama.ystliao.dpdns.org
CHAT_MODEL=qwen3:8b
EMBEDDING_MODEL=qwen3-embedding:0.6b
# 8B 模型经公网隧道，给足超时（秒）
OLLAMA_TIMEOUT_SECONDS=60
# 隧道域名是公网 https，无需放开内网限制
ALLOW_PRIVATE_MODEL_URLS=false

# ---- 存储路径：挂到持久目录，别放代码目录里 ----
CHROMA_DIR=/opt/rag-kb/data/chroma
UPLOAD_DIR=/opt/rag-kb/data/uploads

# ---- 安全：必须换成随机密钥，切勿沿用 please-change-me ----
JWT_SECRET_KEY=CHANGE_ME_TO_RANDOM_64_CHARS

# ---- 允许访问前端的前端地址（换成你服务器的公网IP或域名） ----
CORS_ORIGINS=http://8.8.8.8,http://8.8.8.8:80

# ---- 上传限制 ----
MAX_UPLOAD_BYTES=52428800
MAX_AVATAR_BYTES=2097152
MAX_WEB_PAGE_BYTES=2097152

# ---- 邮件（沿用你本地 163 配置，可改） ----
SMTP_HOST=smtp.163.com
SMTP_PORT=465
SMTP_USERNAME=bingtia2666922@163.com
SMTP_PASSWORD=CHANGE_ME_SMTP_AUTH_CODE
SMTP_FROM_EMAIL=bingtia2666922@163.com
SMTP_FROM_NAME=技术知识库问答系统
SMTP_USE_SSL=true
SMTP_USE_TLS=false

# ---- 检索参数 ----
CHUNK_SIZE=600
CHUNK_OVERLAP=100
TOP_K=5
